# =============================================================================
# CircleDoc 环境变量模板
#
# 用法：复制成 `.env` 后按需修改。**本文件不含任何真实 AK**，真实 AK 一律不入库
# （PRD FR-410 / §5：服务端 AK 只存在于环境变量，禁止写入代码、日志、前端）。
#
# 不填 `.env` 也能起服务（零配置演示路径）：此时所有值取下面的默认值，
# `data_mode` 由启动探测解析成 `mock`，报告仍完整、只是数据来源标注为 `sample`。
#
# 变量名大小写不敏感；字段与默认值的唯一出处是 `infra/config.py`，改代码请同步这里。
# =============================================================================

# -----------------------------------------------------------------------------
# 百度 AK —— 两个必须分开申请、绝不能互换
#   FAQ 2639：JS API 只支持「浏览器类型」AK，Web 服务需要「服务端类型」AK。
#   混用的表现是 `status=203 APP 类型错误`（本项目最高频的坑，见笔记 §4.4）。
#   注意：同账号下各 AK **配额共用**（FAQ 2594），两个 AK 不会把额度翻倍。
# -----------------------------------------------------------------------------
# 服务端类型 AK：后端调 Web 服务用。留空 = 不发实时请求，直接走缓存 / 合成数据
BAIDU_SERVER_AK=
# 浏览器类型 AK：前端加载 JSAPI 用，后端永不用它调 Web 服务
BAIDU_BROWSER_AK=

# -----------------------------------------------------------------------------
# 取数模式
#   data_mode 的值域是 auto|live|cache|mock（用户选的策略）
#   data_source 的值域是 live|cache|sample（实际取了哪一层）——两个别混。
#   默认 auto：由 /api/health 的启动探测解析；探测失败即改 mock，不硬编码成 live。
# -----------------------------------------------------------------------------
DATA_MODE=auto

# -----------------------------------------------------------------------------
# 地址联想（FR-108）——**默认关闭**
#   `/place/v2/suggestion` 与地点检索**共用每日 100 次**配额（笔记 FAQ 2540 / 2549），
#   开着它等于让输入框替用户烧检索额度：敲 10 个字边想边删就是近 10 次调用。
#   关掉时后端**不发任何实时请求**，`/api/suggest` 仍回 HTTP 200 + 一句可读的「未启用」，
#   前端则连请求都不发。确认要占这个配额后再改成 true。
# -----------------------------------------------------------------------------
SUGGEST_ENABLED=false

# -----------------------------------------------------------------------------
# 应用与日志
# -----------------------------------------------------------------------------
APP_NAME=CircleDoc
# dev|test|prod
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# false 时输出人类可读单行文本，只建议本机调试用；CI 与 Docker 保持 true
LOG_JSON=true

# -----------------------------------------------------------------------------
# 出网：域名白名单兼作 SSRF 防护（PRD §5），超时取保守值
# -----------------------------------------------------------------------------
BAIDU_ALLOWED_HOSTS=api.map.baidu.com
BAIDU_CONNECT_TIMEOUT_S=5.0
BAIDU_READ_TIMEOUT_S=12.0
# 同时在途请求上限；刻意低于官方并发口径，因为超限的表现是 `status=401` 而不是 HTTP 429
BAIDU_MAX_CONCURRENCY=4

# -----------------------------------------------------------------------------
# 令牌桶：按服务分桶（不同服务稀缺度相差 50 倍，共用一个桶会互相挤占）
#   rate 一律低于官方 3 QPS 留余量；burst 不要大于 rate，否则桶满时一次放行多个并发
#   必然触发 `status=401`。地址联想与地点检索共用 100 次/日，因此共用 place 桶。
#   ⚠ 下面是 PRD §4.6 的建议值，**请以你账号控制台的实际档位为准**（笔记 §9.2-①）。
# -----------------------------------------------------------------------------
RATE_PLACE_QPS=0.5
BURST_PLACE=1
RATE_REGEO_QPS=0.5
BURST_REGEO=1
RATE_ROUTE_QPS=2.5
BURST_ROUTE=2
RATE_GEOCODE_QPS=1.0
BURST_GEOCODE=2

# -----------------------------------------------------------------------------
# 单次分析的出网预算（三栏分开：place_calls / quota_units / http_requests）
#   把三者混成一个数字会掩盖真实消耗——1 次批量算路 = 1 个 HTTP 请求 = 12 个配额单位。
#   测试时把 MAX_ROUTE_LINES_PER_ANALYSIS 临时改成 1，可验证「预算守护中途截停」；
#   改成 5000 则永不触发，两个方向都不该崩。
# -----------------------------------------------------------------------------
MAX_PLACE_CALLS_PER_ANALYSIS=8
# 口径是**单模式**（步行）。双模式必须按模式数折算，见 Settings.route_lines_budget()。
MAX_ROUTE_LINES_PER_ANALYSIS=150
MAX_QUOTA_UNITS_PER_ANALYSIS=120
# 双模式（步行 + 骑行同跑）放宽到 220（PRD §6.1 验收口径）
MAX_QUOTA_UNITS_DUAL_MODE=220
MAX_HTTP_REQUESTS_PER_ANALYSIS=20

# -----------------------------------------------------------------------------
# 重试与双熔断（判据一律来自 HTTP 200 响应体里的 `status`，见 infra/errors.py）
# -----------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.5
RETRY_MAX_DELAY_S=8.0
# `status=401` 首次退避下限：QPS 窗口以秒计，退避小于 1 s 等于白重试
RETRY_CONCURRENCY_FIRST_DELAY_S=1.0
# concurrency_breaker：连续 5 次 401/1/网络超时 → 打开 30 s
CONCURRENCY_BREAKER_THRESHOLD=5
CONCURRENCY_BREAKER_HOLD_S=30
# quota_breaker：命中 4 / 302 打开到**次日零时**（30 s 重连只会加速烧配额）。
# 东八区无夏令时，用固定偏移而不是 tzdata（Windows 常缺时区库）。
QUOTA_BREAKER_TZ_OFFSET_HOURS=8

# -----------------------------------------------------------------------------
# 缓存：定位为同进程运行时性能缓存，不是数据资产库（FR-402 / 条款 3.3.4）
#   表结构收敛为 cache(key, service, payload, created_at, expires_at)，
#   不建可查询的 POI 维度表；过期行物理删除；镜像内不得预置任何 .db 文件。
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DB_PATH=data/cache.db
# 地址映射极稳定，30 天
CACHE_TTL_GEOCODE_S=2592000
CACHE_TTL_REGEO_S=2592000
# ⚠ POI 检索 24 h 是**合规上限**（v1.0 的 3 天已下调），不是官方给出的允许值；
# 填更大会被 config 的 model validator 强制夹回 86400 并记一条 config_notes。
CACHE_TTL_PLACE_S=86400
# 路网稳定，7 天；§2.2 的「命中率 ≥ 95 %」主要来自这两项
CACHE_TTL_ROUTE_S=604800
CACHE_TTL_ISOCHRONE_S=604800
# 错误响应永不缓存
CACHE_ERROR_TTL_S=0

# -----------------------------------------------------------------------------
# 目录与首屏默认值
# -----------------------------------------------------------------------------
SAMPLES_DIR=data/samples
WEB_DIR=web
# 预置样例社区**清单**（FR-102）：社区名 / 行政区 / 坐标 / 建成形态画像。
# ⚠️ 与 SAMPLES_DIR 是两件事：那是**合成数据的落点**（golden 基线），这是**清单**。
# 坐标必须国内；文件里的 coord_verified 标记它是否已实调核验，/api/samples 会原样透出。
SAMPLES_CONFIG_PATH=config/samples.yaml
# 评分权重表（PRD §4.5 明确要求权重外置而不是写死在代码里）。
# 缺失 / 读坏时回落内置默认值并留一条 note，不会把体检变成错误页（FR-403 的同一取舍）。
WEIGHTS_PATH=config/weights.yaml
# 首屏默认中心点（BD09LL）。经纬度分两个变量，是为了让 .env 里不出现 JSON 元组写法。
DEFAULT_CENTER_LNG=116.404
DEFAULT_CENTER_LAT=39.915

# -----------------------------------------------------------------------------
# 入参边界（PRD §5：范围校验在入口做）
# -----------------------------------------------------------------------------
MIN_MINUTES=5
MAX_MINUTES=60
MAX_RADIUS_M=5000
# 样例社区必须落在国内：境外各服务对个人档配额为「-」，探测必然失败
CHINA_LNG_MIN=73.5
CHINA_LNG_MAX=135.1
CHINA_LAT_MIN=18.1
CHINA_LAT_MAX=53.5

# -----------------------------------------------------------------------------
# 可选：指定 .env 之外的配置文件路径（Docker 里 cwd 与本机不同时用得上）
# -----------------------------------------------------------------------------
# CIRCLEDOC_ENV_FILE=/app/.env
